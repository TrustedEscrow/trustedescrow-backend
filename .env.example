# --- API ---------------------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
PUBLIC_WEB_URL=http://localhost:3001
# Comma-separated; defaults to PUBLIC_WEB_URL
CORS_ORIGINS=

DATABASE_URL=postgres://postgres:postgres@localhost:5432/trustescrow

# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Encrypts TOTP seeds at rest. It is NOT a delivery-code key: the server has none.
SERVER_ENCRYPTION_KEY=

SESSION_TTL_SECONDS=604800
AUTH_CHALLENGE_TTL_SECONDS=300
STEP_UP_TTL_SECONDS=300
# Embedded in sign-in challenges so signatures can't be replayed on another site
AUTH_DOMAIN=trustescrow.local

# --- Stellar -----------------------------------------------------------------
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
FACTORY_CONTRACT_ID=
# Rails offered in drafts. tokenAddress must be on the factory allowlist.
# Testnet USDC SAC shown; verify before use.
RAILS=[{"id":"usdc-stellar","tokenAddress":"CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA","displaySymbol":"USDC","decimals":7}]
# Comma-separated arbitrator account addresses (G...)
ARBITRATOR_ADDRESSES=

# --- Indexer -----------------------------------------------------------------
INDEXER_POLL_INTERVAL_MS=5000
# First ledger to index (the factory's deployment ledger). 0 = start at head.
INDEXER_START_LEDGER=0
INDEXER_PAGE_LIMIT=200

# --- Notifier ----------------------------------------------------------------
NOTIFIER_POLL_INTERVAL_MS=30000
EMAIL_DRIVER=console
SMTP_URL=
EMAIL_FROM=TrustEscrow <no-reply@trustescrow.local>

# --- Keeper (separate process; the API never reads this) ---------------------
# A funded account that pays fees for permissionless timeout and bump calls.
KEEPER_SECRET=
KEEPER_POLL_INTERVAL_MS=60000
KEEPER_BUMP_THRESHOLD_LEDGERS=120960
KEEPER_DRY_RUN=false

# --- Evidence ----------------------------------------------------------------
EVIDENCE_STORAGE_DIR=./storage/evidence
EVIDENCE_MAX_BYTES=10485760
