{
  "name": "trustescrow-backend",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "TrustEscrow backend: drafts, messaging, notifications, 2FA, encrypted code vault and read cache. Holds no authority over funds.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:indexer": "node dist/workers/indexer.js",
    "start:notifier": "node dist/workers/notifier.js",
    "start:keeper": "node dist/workers/keeper.js",
    "migrate": "tsx src/db/migrate-cli.ts",
    "reconcile": "tsx src/cli/reconcile.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@stellar/stellar-sdk": "^17.0.1",
    "fastify": "^5.12.4",
    "kysely": "^0.29.5",
    "nodemailer": "^10.0.9",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "zod": "^4.6.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.20.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
